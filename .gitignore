# Bastione — .gitignore (§4, L05)

# Output delle run: contiene evidenze grezze (anche segreti NON redatti) → MAI committare.
runs/

# Config reale per-target, con token/segreti → gitignored.
# I file template `targets/<nome>.toml` (senza segreti) invece SI committano.
targets/*.local.toml

# NB: `baselines/` NON è ignorata, volutamente. Il formato §16 contiene solo
# id/status/date (nessuna evidenza) ed è committata apposta per il diff in CI (§22).
# Non aggiungere `baselines/` qui sotto.

# Sandbox-site da deployare (materiale di deploy locale, non codice del tool;
# contiene la anon key pubblica del sandbox usa-e-getta) → mai nel repo.
bozza/

# Ambiente / cache Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/
.env
